# ---- Backend ----
APP_ENV=development
# Local: sqlite:///./plant_care.db   |  Cloud (Supabase): postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./plant_care.db
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
MAX_WATERING_SECONDS=30
COOLDOWN_SECONDS=60
MIN_TANK_LEVEL=10
OFFLINE_AFTER_SECONDS=30
EXPECTED_INTERVAL_SECONDS=2
RATE_LIMIT_PER_MINUTE=120

# ---- Sensor simulator ----
API_URL=http://localhost:8000
DEVICE_ID=PLANT-001
DEVICE_API_KEY=paste-key-printed-by-seed-script
SIM_INTERVAL_SECONDS=2

# ---- Demo seed (local demo only) ----
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-demo-password
DEMO_DEVICE_API_KEY=change-me-demo-key
